<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.codewitness</groupId>
    <artifactId>codewitness-parent</artifactId>
    <version>1.0.8</version>
  </parent>

  <artifactId>codewitness-cli</artifactId>
  <name>CodeWitness :: CLI</name>
  <description>Command line interface and runtime wiring.</description>

  <dependencies>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-report</artifactId>
    </dependency>
    <!-- The composition root wires the shared database fixture, so it says so explicitly rather than
         relying on an adapter happening to bring the module along. -->
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-support</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-java</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-python</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-rust</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-go</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-javascript</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-typescript</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-csharp</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-kotlin</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-cpp</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-php</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-ruby</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-swift</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-verilog</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-vhdl</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-sql</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-adapter-pascal</artifactId>
    </dependency>
    <!-- Recognition of languages nothing can verify. A dependency rather than a hard-coded table in the
         core, so that a report can name Perl or Elixir without the engine knowing what Perl or Elixir
         are. -->
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-language-detectors</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <!-- sqlite-jdbc brings slf4j-api without a binding, which makes every run print a "defaulting to
         no-operation logger" warning. This binding silences it without adding log output. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>1.7.36</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>codewitness</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.codewitness.cli.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
