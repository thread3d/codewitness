<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.codewitness</groupId>
  <artifactId>codewitness-parent</artifactId>
  <version>0.1.6</version>
  <packaging>pom</packaging>

  <name>CodeWitness</name>
  <description>Independent verification engine for AI-generated software</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>thread3d</id>
      <name>thread3d</name>
      <roles>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>

  <modules>
    <module>codewitness-core</module>
    <module>codewitness-language-detectors</module>
    <module>codewitness-storage</module>
    <module>codewitness-report</module>
    <!-- Shared adapter machinery. Built before the adapters that depend on it. -->
    <module>codewitness-adapter-support</module>
    <module>codewitness-adapter-java</module>
    <module>codewitness-adapter-python</module>
    <module>codewitness-adapter-rust</module>
    <module>codewitness-adapter-go</module>
    <module>codewitness-adapter-javascript</module>
    <module>codewitness-adapter-typescript</module>
    <module>codewitness-adapter-csharp</module>
    <module>codewitness-adapter-kotlin</module>
    <module>codewitness-adapter-cpp</module>
    <module>codewitness-adapter-php</module>
    <module>codewitness-adapter-ruby</module>
    <module>codewitness-adapter-swift</module>
    <module>codewitness-adapter-verilog</module>
    <module>codewitness-adapter-vhdl</module>
    <module>codewitness-adapter-sql</module>
    <module>codewitness-adapter-pascal</module>
    <module>codewitness-cli</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <!-- Jackson's own BOM pins every Jackson artifact to one version. 2.17.1 carried high severity
         advisories in jackson-core and jackson-databind; 2.21.7 is the earliest release with none
         affecting the artifacts this project uses, checked against OSV. -->
    <jackson.version>2.21.7</jackson.version>
    <picocli.version>4.7.6</picocli.version>
    <sqlite.version>3.45.3.0</sqlite.version>
    <snakeyaml.version>2.2</snakeyaml.version>
    <!-- End-to-end tests drive real Maven builds of fixture projects; they are opt-in so that the
         default build stays fast and does not need the network. Run them with -Pe2e. -->
    <excluded.groups>e2e</excluded.groups>
    <!-- Surefire's argLine must be built from this property rather than hard-coded, because JaCoCo's
         prepare-agent sets this property at runtime. An empty default keeps a plain `mvn test`
         working; see the surefire configuration below. -->
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite.version}</version>
      </dependency>
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>${snakeyaml.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-java</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-python</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-rust</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-go</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-javascript</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-typescript</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-csharp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-kotlin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-cpp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-php</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-ruby</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-swift</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-verilog</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-vhdl</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-sql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-adapter-pascal</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.codewitness</groupId>
        <artifactId>codewitness-language-detectors</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${excluded.groups}</excludedGroups>
          <!-- sqlite-jdbc loads a native library, which JDK 24+ treats as restricted native access
               and warns about. The warning becomes an error in a future release, so grant it here
               rather than letting the build drift towards failure.
               @{argLine} is late-replaced with the argLine property at execution time, which is how
               JaCoCo's prepare-agent contributes -javaagent:... to the test JVM. Writing the flag as
               a literal instead would silently override the agent and make coverage unmeasurable. -->
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>e2e</id>
      <properties>
        <!-- Surefire treats an unset/blank group filter as "exclude nothing". -->
        <excluded.groups></excluded.groups>
      </properties>
    </profile>
  </profiles>
</project>
