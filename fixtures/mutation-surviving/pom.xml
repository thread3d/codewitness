<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>mutation-surviving</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>mutation-surviving</name>
  <description>
    Fixture project for CodeWitness: the implementation is correct with respect to the declared
    requirement, but the project's own tests are too weak and a mutant survives. CodeWitness must
    report the surviving mutant as a test-strength limitation, not as a requirement failure.
  </description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Mutation testing is configured here, in the project, exactly as a real project must do:
           PIT needs to know which plugin to use to run this project's test framework. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.0</version>
        <configuration>
          <targetClasses>
            <param>com.example.*</param>
          </targetClasses>
        </configuration>
        <dependencies>
          <!-- PIT discovers its test framework plugin on the plugin classpath. -->
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
