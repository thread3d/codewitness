<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for the CodeWitness PHP fixture.

  `bootstrap` is what makes a test class findable: PHPUnit has no notion of a test tree it discovers by
  name alone, so the Composer autoloader is loaded and the class is resolved through the PSR-4 prefixes
  in composer.json. `cacheDirectory` is kept inside the project because the isolated workspace excludes
  a stale `.phpunit.cache` from the copy, so a run never reads another run's results.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="false"
         failOnWarning="true">
  <testsuites>
    <testsuite name="withdrawal-ledger">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>src</directory>
    </include>
  </source>
</phpunit>
