# Build output. These patterns must not swallow a source package that happens to be called
# "build" or "target": this repository itself has a dev.codewitness.java.build package, and
# ignoring it silently left those sources out of the repository.
target/
build/
!**/src/**/build/
!**/src/**/target/
.gradle/
*.class
*.log

# Rust fixtures are libraries built directly from the working tree during development; Cargo
# regenerates a lock file that matches the toolchain in use, so it is not committed.
fixtures/**/Cargo.lock

# Go fixtures are dependency free, and the Go tool writes no lock file; keep build output and any
# local module cache out of the tree if a developer runs go in a fixture by hand.
fixtures/**/go.sum
fixtures/**/vendor/

# Node dependencies and build output. The TypeScript fixture needs none of these to be verified,
# but a developer who runs `npm install` in it should not commit the result.
node_modules/
fixtures/**/dist/
fixtures/**/*.tsbuildinfo

# .NET dependencies and build output. The C# fixture restores the .NET SDK's own test host, which every
# .NET project needs, and the SDK writes compiled assemblies to bin and intermediate files to obj; a
# developer who runs `dotnet test` in a fixture by hand should not commit either. TestResults holds the
# TRX and coverage reports of such a run.
fixtures/**/bin/
fixtures/**/obj/
fixtures/**/TestResults/

# Kotlin build output. The Kotlin fixture is built by Maven, whose output is already ignored, but a
# developer who opens it in Gradle or IntelliJ gets a .kotlin directory and a Gradle build directory.
fixtures/**/.kotlin/

# PHP dependencies and caches. The PHP fixture's `composer.lock` *is* committed, because Composer's
# convention is that an application pins its dependencies and its lock file is what makes a later
# `composer install` reproduce the same tree; vendor is the result of that install, and a developer who
# runs it by hand should not commit it. The two PHPUnit caches are per-machine result caches.
fixtures/**/vendor/
fixtures/**/.phpunit.cache/
fixtures/**/.phpunit.result.cache/

# Ruby dependencies and caches. The Ruby fixture's `Gemfile.lock` *is* committed, for the same reason
# Composer's is: an application pins its dependency versions and the lock file is what makes a later
# `bundle install` reproduce the same tree. The bundle itself lands in vendor/bundle and is covered
# above; `.bundle` holds this machine's local configuration, and `coverage` holds SimpleCov's results
# from a previous run.
fixtures/**/.bundle/
fixtures/**/coverage/
fixtures/**/.rspec_status

# Swift Package Manager's scratch tree. `Package.resolved` *is* committed, for the same reason the
# Ruby and Composer lock files are: it pins the exact package revisions a later `swift build`
# reproduces. `.build` is the compiled product, the checked-out dependencies and the coverage output of
# whichever run produced them, all keyed to this machine's toolchain; `.swiftpm` is the package's own
# local configuration.
fixtures/**/.build/
fixtures/**/.swiftpm/
fixtures/**/DerivedData/

# Icarus Verilog's build output. The adapter writes its compiled simulation inside the run's artefact
# directory, but a developer who runs `iverilog`/`vvp` in a fixture by hand writes `a.out` (Icarus's
# default output name when no -o is given), a `.vvp` simulation and a `.vcd`/`.fst` waveform into the
# tree. Verilator's scratch tree, obj_dir, and its coverage data are the same kind of thing. Nothing
# here is a source file: a Verilog project is source, testbenches and at most a file list.
fixtures/**/a.out
fixtures/**/*.vvp
fixtures/**/*.vcd
fixtures/**/*.fst
fixtures/**/obj_dir/

# Free Pascal's build output. The adapter directs the `.ppu` units, the `.o` objects and the executable
# into the run's artefact directory, but a developer who runs `fpc` in a fixture by hand writes them
# beside the source: a unit produces `<name>.ppu` and `<name>.o`, and a program also produces an
# executable, a `.lps` Lazarus session file and `link.res`. Nothing here is a source file: a Pascal
# project is units, programs and tests.
fixtures/**/*.ppu
fixtures/**/*.o
fixtures/**/*.lps
fixtures/**/link.res
fixtures/**/*.a

# CodeWitness run data produced inside the repository
.codewitness/
**/.codewitness/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# macOS
.DS_Store
