<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.codewitness</groupId>
    <artifactId>codewitness-parent</artifactId>
    <version>1.0.5</version>
  </parent>

  <artifactId>codewitness-adapter-support</artifactId>
  <name>CodeWitness :: Adapter Support</name>
  <description>Machinery shared by more than one language adapter, none of which belongs in the
    language-independent core: the text mutator, the mutation tester loop that drives it, and the
    lock-file readers that turn a resolved dependency graph into advisory coordinates.</description>

  <dependencies>
    <!-- This module holds machinery used by more than one adapter, so it depends on core for the SPI
         types it implements: the shared mutation tester is a VerificationTools.MutationTester. -->
    <dependency>
      <groupId>dev.codewitness</groupId>
      <artifactId>codewitness-core</artifactId>
    </dependency>

    <!-- package-lock.json is nested JSON, and a lock file misread as flat text would attribute a
         version to the wrong package. It is parsed with a real parser, the same one the advisory
         scanner already uses. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- The SQLite database fixture creates and loads a real database rather than parsing a schema, and
         it uses the same JDBC driver the run store already ships so that one driver serves the whole
         tool. A fixture is infrastructure shared by every language, which is why it lives here beside
         the other shared machinery. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
